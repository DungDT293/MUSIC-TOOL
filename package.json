{
  "name": "93-media-tool-mix-nhac",
  "version": "4.2.3",
  "description": "Media tool for mixing music and video editing",
  "main": "dist-electron/main/main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:test-server": "electron-vite dev",
    "build": "electron-vite build",
    "postbuild": "node scripts/inject-hash.js",
    "build:ui": "vite build",
    "build:app": "npm run build && electron-builder --config electron-builder.json5",
    "build:win": "npm run build && electron-builder --config electron-builder.json5 --win",
    "clean:output": "node -e \"try { require('fs').rmSync('dist-electron-output', { recursive: true, maxRetries: 2 }); console.log('OK dist-electron-output removed'); } catch (e) { console.error('Loi xoa output (dong app/build truoc):', e.message); process.exit(1); }\"",
    "clean:build:win": "npm run clean:output && npm run build:win",
    "build:win-portable": "npm run build && electron-builder --config electron-builder.json5 --win portable",
    "build:win-installer": "npm run build && electron-builder --config electron-builder.json5 --win nsis",
    "build:all": "npm run build && electron-builder --config electron-builder.json5 --win --mac --linux",
    "dist": "npm run build:app",
    "dist:win": "npm run build:win",
    "dist:installer": "npm run build:win-installer",
    "preview": "electron-vite preview",
    "lint": "eslint . --ext .ts,.tsx",
    "backup": "node scripts/backup.js",
    "backup:manual": "echo Please create backup manually in backups/ folder",
    "test:unit": "vitest run --reporter=verbose",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --reporter=verbose",
    "test:e2e:ui": "vitest --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:playwright": "playwright test",
    "test": "vitest run",
    "test:ytdlp": "tsx backend/youtube/__tests__/testYtDlp.ts",
    "test:download": "tsx backend/youtube/__tests__/testDownload.ts",
    "test:channel": "tsx backend/youtube/__tests__/testChannel.ts",
    "test:canvas-export": "tsx backend/video/canvasExport/__tests__/timelineResolver.test.ts"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@foobar404/wave": "^2.0.5",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@xenova/transformers": "^2.17.2",
    "audiomotion-analyzer": "^4.5.2",
    "butterchurn": "^2.6.7",
    "butterchurn-presets": "^2.4.7",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.7.3",
    "fabric": "^7.0.0",
    "jszip": "^3.10.1",
    "konva": "^10.2.0",
    "lucide-react": "^0.562.0",
    "mp4-muxer": "^5.2.2",
    "react": "^18.3.1",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.14",
    "react-router-dom": "^6.30.1",
    "three": "^0.182.0",
    "uuid": "^13.0.0",
    "vanta": "^0.5.24",
    "zod": "^4.3.5",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/fabric": "^5.3.10",
    "@types/node": "^20.19.25",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.2",
    "dotenv": "^16.4.7",
    "electron": "^36.9.5",
    "electron-builder": "^26.8.1",
    "electron-playwright-helpers": "^2.1.0",
    "electron-vite": "^5.0.0",
    "fs-extra": "^11.3.2",
    "javascript-obfuscator": "^4.2.1",
    "milkdrop-preset-converter": "^0.1.2",
    "playwright": "^1.58.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-glsl": "^1.5.5",
    "vitest": "^4.1.2"
  }
}
