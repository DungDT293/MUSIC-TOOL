# .env.production — Copy file này thành .env.production và điền giá trị thật
# File .env.production KHÔNG được commit vào git (xem .gitignore)

# Key xác thực installer — lấy từ admin
LICENSE_INSTALLER_KEY=your-installer-key-here

# Secret installer — lấy từ admin
LICENSE_INSTALLER_SECRET=your-installer-secret-here

# License server base URL (có thể để trống để dùng default)
# LICENSE_SERVER_BASE=https://license-server.dungdong333.workers.dev
